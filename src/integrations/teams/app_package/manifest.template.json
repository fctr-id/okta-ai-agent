{
  "$schema": "https://developer.microsoft.com/json-schemas/teams/v1.23/MicrosoftTeams.schema.json",
  "manifestVersion": "1.23",
  "version": "0.2.0",
  "id": "<TEAMS_APP_ID>",
  "developer": {
    "name": "Tako AI",
    "websiteUrl": "https://github.com/fctr-id/okta-ai-agent",
    "privacyUrl": "https://github.com/fctr-id/okta-ai-agent#security--privacy",
    "termsOfUseUrl": "https://github.com/fctr-id/okta-ai-agent/blob/main/LICENSE"
  },
  "name": {"short": "Tako AI", "full": "Tako AI for Okta"},
  "description": {
    "short": "Ask questions and follow-ups about your organization's Okta data.",
    "full": "Query your organization's customer-hosted Tako AI instance from a personal chat. Continue conversations and download retrieved results as CSV. Access requires administrator-configured Entra group membership. AI can make mistakes. Please validate the data provided."
  },
  "icons": {"color": "color.png", "outline": "outline.png"},
  "accentColor": "#3F5FE8",
  "bots": [{
    "botId": "<BOT_CLIENT_ID>",
    "scopes": ["personal"],
    "supportsFiles": true,
    "isNotificationOnly": false,
    "commandLists": [{
      "scopes": ["personal"],
      "commands": [
        {"title": "help", "description": "How to ask questions and follow-ups"},
        {"title": "status", "description": "View data sync status"},
        {"title": "cancel", "description": "Cancel your active request"},
        {"title": "new", "description": "Start a new conversation"}
      ]
    }]
  }],
  "validDomains": []
}
